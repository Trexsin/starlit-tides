# Copy to .env.local for `vercel dev` (or run `vercel env pull .env.local`).
# NEVER commit the real values - .env* files are git-ignored.
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
# Optional: any random string; makes the hashed client IDs unguessable.
RATE_LIMIT_SALT=change-me
